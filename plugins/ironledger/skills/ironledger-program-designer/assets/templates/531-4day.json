    },
    "2": {
      "source": "CT-GEN-2: squat + bench, then deadlift + OHP; no supplemental (L-14)",
      "supplemental": null,
      "days": [
        {
          "extras": ["Warm-up: knee mobility"],
          "main": ["Squat", "Bench Press"],
          "slots": [
            {"id": "sb.hinge", "pattern": "hip-hinge", "kind": "compound",
