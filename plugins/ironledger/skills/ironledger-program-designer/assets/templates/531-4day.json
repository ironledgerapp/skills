             "sets": 3, "reps": "10-12", "rir": "2"},
            {"id": "sb.hamstring", "pattern": "knee-flexion", "kind": "isolation",
             "exercise": "Leg Curl", "alternatives": ["Seated Leg Curl", "Lying Leg Curl", "Nordic Curl"],
             "sets": 3, "reps": "10-12", "rir": "2-3"},
            {"id": "sb.delts", "pattern": "shoulder-abduction", "kind": "isolation",
