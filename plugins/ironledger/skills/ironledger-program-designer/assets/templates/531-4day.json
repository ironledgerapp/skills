             "sets": 3, "reps": "10-12", "rir": "2"},
            {"id": "do.pull", "pattern": "vertical-pull", "kind": "compound",
             "exercise": "Lat Pulldown", "alternatives": ["Chin Up", "Pull Up", "Seated Cable Row"],
             "sets": 3, "reps": "10-12", "rir": "2"},
            {"id": "do.trunk", "pattern": "trunk-flexion", "kind": "core",
             "exercise": "Cable Crunch", "alternatives": ["Ab Wheel Rollout", "Hanging Knee Raise", "Dead Bug"],
             "sets": 3, "reps": "12-20", "rir": "2-4"}
          ]
        },
        {
          "label": "Full body",
          "extras": ["Warm-up: knee mobility"],
          "slots": [
            {"id": "fb.unilateral", "pattern": "squat-unilateral", "kind": "compound",
             "exercise": "Bulgarian Split Squat", "alternatives": ["Dumbbell Split Squat", "Dumbbell Lunge", "Goblet Squat"],
             "sets": 3, "reps": "10-12", "rir": "2"},
            {"id": "fb.hinge", "pattern": "hip-hinge", "kind": "compound",
             "exercise": "Romanian Deadlift", "alternatives": ["Dumbbell Romanian Deadlift", "Back Extension", "Cable Pull Through"],
             "sets": 3, "reps": "8-10", "rir": "2"},
            {"id": "fb.press", "pattern": "incline-press", "kind": "compound",
             "exercise": "Dumbbell Incline Press", "alternatives": ["Machine Chest Press", "Dumbbell Bench Press", "Push Up"],
             "sets": 3, "reps": "10-12", "rir": "2"},
            {"id": "fb.row", "pattern": "horizontal-pull", "kind": "compound",
             "exercise": "Seated Cable Row", "alternatives": ["Chest Supported Row", "Dumbbell Row", "Inverted Row"],
