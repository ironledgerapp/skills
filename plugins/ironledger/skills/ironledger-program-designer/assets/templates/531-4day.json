{
  "schema": "designer-template/1",
  "id": "531-4day",
  "name": "5/3/1, one main lift a day",
  "engine": "531",
  "client_types": ["GEN", "HYP"],
  "default_days": 4,
  "rules": ["L-5", "L-6", "L-7", "L-8", "L-13", "L-14", "L-15", "L-16", "A-1", "A-2", "A-3", "A-4", "CT-GEN-1", "CT-GEN-2", "CT-HYP-2", "CT-HYP-3", "CT-PT-2"],
  "decisions_relied_on": ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9", "M11", "M12", "M13", "M16", "M20"],
  "equipment_required": ["barbell", "rack", "bench"],
  "weeks": [
    {"week": 1, "kind": "loading", "wave": 1},
    {"week": 2, "kind": "loading", "wave": 2},
    {"week": 3, "kind": "loading", "wave": 3},
    {"week": 4, "kind": "deload"}
  ],
  "rest": {"main": "Rest 3 min", "main_heavy": "Rest 3-5 min", "supplemental": "Rest 2 min"},
  "amrap": {"rir": "1-2", "cue": "as many strong reps as you can, leaving 1 to 2 in the tank"},
  "supplemental": {"type": "fsl", "sets": 5},
  "layouts": {
    "4": {
      "source": "L-15, A-2",
      "days": [
        {
          "label": "Squat",
          "extras": ["Warm-up: knee mobility"],
          "main": ["Squat"],
          "slots": [
            {"id": "squat.unilateral", "pattern": "squat-unilateral", "kind": "compound",
             "exercise": "Bulgarian Split Squat", "alternatives": ["Dumbbell Split Squat", "Dumbbell Lunge", "Goblet Squat"],
             "sets": 3, "reps": "10-12", "rir": "2",
             "by_type": {"HYP": {"exercise": "Hack Squat", "alternatives": ["Leg Press", "Pendulum Squat", "Smith Machine Squat"],
                                 "sets": 2, "reps": "6-10", "rir": "0"}}},
            {"id": "squat.hamstring", "pattern": "knee-flexion", "kind": "isolation",
             "exercise": "Leg Curl", "alternatives": ["Seated Leg Curl", "Lying Leg Curl", "Nordic Curl"],
             "sets": 3, "reps": "10-12", "rir": "2-3"},
            {"id": "squat.trunk", "pattern": "trunk-flexion", "kind": "core",
             "exercise": "Cable Crunch", "alternatives": ["Hanging Leg Raise", "Hanging Knee Raise", "Dead Bug"],
             "sets": 3, "reps": "12-20", "rir": "2-4"}
          ]
        },
        {
          "label": "Bench",
          "extras": ["Warm-up: upper mobility"],
          "main": ["Bench Press"],
          "slots": [
            {"id": "bench.press", "pattern": "horizontal-press", "kind": "compound",
             "exercise": "Dumbbell Bench Press", "alternatives": ["Machine Chest Press", "Dumbbell Incline Press", "Push Up"],
             "sets": 3, "reps": "10-12", "rir": "2", "tempo": "Full ROM",
             "by_type": {"HYP": {"exercise": "Machine Chest Press", "alternatives": ["Smith Machine Bench Press", "Dumbbell Bench Press"],
                                 "sets": 2, "reps": "6-10", "rir": "0"}}},
            {"id": "bench.row", "pattern": "horizontal-pull", "kind": "compound",
             "exercise": "Dumbbell Row", "alternatives": ["Chest Supported Row", "Seated Cable Row", "Chin Up"],
             "sets": 3, "reps": "10-12", "rir": "2",
             "by_type": {"HYP": {"rir": "2-3"}}},
            {"id": "bench.delts", "pattern": "shoulder-abduction", "kind": "isolation",
             "exercise": "Lateral Raise", "alternatives": ["Cable Lateral Raise", "Machine Lateral Raise"],
             "sets": 3, "reps": "12-15", "rir": "2-3", "amrap_last_set": true},
            {"id": "bench.triceps", "pattern": "elbow-extension", "kind": "isolation",
             "exercise": "Cable Tricep Pushdown", "alternatives": ["Rope Pushdown", "Dumbbell Tricep Extension", "Overhead Cable Extension"],
             "sets": 3, "reps": "10-12", "rir": "2-3"}
          ]
        },
        {
          "label": "Deadlift",
          "extras": ["Warm-up: hinge mobility"],
          "main": ["Deadlift"],
          "slots": [
            {"id": "deadlift.hinge", "pattern": "hip-hinge", "kind": "compound",
             "exercise": "Romanian Deadlift", "alternatives": ["Dumbbell Romanian Deadlift", "Back Extension", "Cable Pull Through"],
             "sets": 3, "reps": "8-10", "rir": "2",
             "by_type": {"HYP": {"sets": 2, "reps": "6-10", "rir": "1"}}},
            {"id": "deadlift.squat", "pattern": "squat", "kind": "compound",
             "exercise": "Leg Press", "alternatives": ["Goblet Squat", "Hack Squat", "Dumbbell Split Squat"],
             "sets": 3, "reps": "10-12", "rir": "2",
             "by_type": {"HYP": {"sets": 2, "reps": "6-10", "rir": "0"}}},
            {"id": "deadlift.trunk", "pattern": "anti-extension", "kind": "core",
             "exercise": "Ab Wheel Rollout", "alternatives": ["Cable Crunch", "Hanging Knee Raise", "Dead Bug"],
             "sets": 3, "reps": "10-15", "rir": "2-4"}
          ]
        },
        {
          "label": "Press",
          "extras": ["Warm-up: upper mobility"],
          "main": ["Overhead Press"],
          "slots": [
            {"id": "press.incline", "pattern": "incline-press", "kind": "compound",
             "exercise": "Dumbbell Incline Press", "alternatives": ["Machine Chest Press", "Dumbbell Bench Press", "Incline Bench Press"],
             "sets": 3, "reps": "10-12", "rir": "2", "tempo": "Full ROM",
             "by_type": {"HYP": {"sets": 2, "reps": "6-10", "rir": "1"}}},
            {"id": "press.row", "pattern": "horizontal-pull", "kind": "compound",
             "exercise": "Seated Cable Row", "alternatives": ["Chest Supported Row", "Dumbbell Row", "Lat Pulldown"],
             "sets": 3, "reps": "10-12", "rir": "2",
             "by_type": {"HYP": {"rir": "2-3"}}},
            {"id": "press.pushup", "pattern": "horizontal-press", "kind": "compound",
             "exercise": "Push Up", "alternatives": ["Incline Push Up", "Dips"],
             "sets": 3, "reps": "10-15", "rir": "2"},
            {"id": "press.triceps", "pattern": "elbow-extension", "kind": "isolation",
             "exercise": "Rope Pushdown", "alternatives": ["Cable Tricep Pushdown", "Overhead Cable Extension", "Dumbbell Tricep Extension"],
             "sets": 3, "reps": "10-12", "rir": "2-3", "amrap_last_set": true}
          ]
        }
      ]
    },
    "3": {
      "source": "CT-GEN-2: squat + bench, deadlift + OHP, then a full-body accessory day; no supplemental (L-14)",
      "supplemental": null,
      "days": [
